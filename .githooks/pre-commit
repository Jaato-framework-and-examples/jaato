#!/usr/bin/env bash
# Pre-commit hook: keep generated files in sync with their sources.
#
# 1. jaato-sdk/jaato_sdk/events.py -> jaato-sdk-ts/src/events.ts
#    (scripts/codegen_ts_events.py), so the "Codegen: jaato-sdk-ts events.ts
#    staleness" CI check stays green.
# 2. jaato-server source (and its pyproject.toml, whose version the snapshot
#    records) -> jaato-sdk/jaato_sdk/scaffold/authoring_snapshot.json
#    (python -m jaato_server.shared.scaffold.authoring_contracts --write), so
#    test_authoring_does_not_load_introspection_1267 stays green (#1267).
#
# Each regenerates only when a commit touches its sources, and stages the
# result so it lands in the same commit.
#
# Activate once per clone:
#     git config core.hooksPath .githooks
#
# Override the interpreter if jaato isn't on the default python:
#     PYTHON=/path/to/venv/bin/python git commit ...
# Bypass entirely:  git commit --no-verify
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
py="${PYTHON:-python3}"
staged="$(git diff --cached --name-only --diff-filter=ACMRD)"

# --- 1. events.ts -----------------------------------------------------------
if grep -qx 'jaato-sdk/jaato_sdk/events.py' <<<"$staged"; then
    echo "pre-commit: events.py changed — regenerating events.ts ..."
    if ! "$py" "$repo_root/scripts/codegen_ts_events.py"; then
        {
            echo "pre-commit: FAILED to regenerate events.ts."
            echo "  Run it with jaato-sdk installed (pip install -e jaato-sdk/):"
            echo "      python scripts/codegen_ts_events.py"
            echo "  or point the hook at your venv: PYTHON=.venv/bin/python git commit ..."
            echo "  To bypass this hook: git commit --no-verify"
        } >&2
        exit 1
    fi
    git add "$repo_root/jaato-sdk-ts/src/events.ts"
    echo "pre-commit: events.ts regenerated + staged."
fi

# --- 2. authoring_snapshot.json ---------------------------------------------
# The snapshot projects env-var reads from any non-test module under
# jaato_server/{server,shared} and the provider contracts under
# model_provider/, so any such .py file can change it, and it records
# jaato-server's version, so a bump in its pyproject.toml does too.  Tests
# cannot.  It ships in the SDK wheel (#1267), so it lives under jaato-sdk/.
snapshot="jaato-sdk/jaato_sdk/scaffold/authoring_snapshot.json"
# (No `grep -q` here: under pipefail, -q exiting early can SIGPIPE the first
# grep and turn a match into a non-zero pipeline.)
sources="$(grep -E '^jaato-server/(jaato_server/(server|shared)/.*\.py|pyproject\.toml)$' <<<"$staged" \
           | grep -vE '/tests/' || true)"
if [ -n "$sources" ]; then
    echo "pre-commit: jaato-server source changed — regenerating $(basename "$snapshot") ..."
    # PYTHONPATH first, so the scan reads -- and the snapshot is written into --
    # THIS checkout, not whichever one an editable install points at (a git
    # worktree shares the venv of the main clone).  Both packages: the scan is
    # jaato-server's, the writer and the file are jaato-sdk's.
    if ! PYTHONPATH="$repo_root/jaato-server:$repo_root/jaato-sdk${PYTHONPATH:+:$PYTHONPATH}" \
            "$py" -m jaato_server.shared.scaffold.authoring_contracts --write >/dev/null; then
        {
            echo "pre-commit: FAILED to regenerate $snapshot."
            echo "  Run it with both packages installed (pip install -e jaato-sdk/ -e jaato-server/):"
            echo "      python -m jaato_server.shared.scaffold.authoring_contracts --write"
            echo "  or point the hook at your venv: PYTHON=.venv/bin/python git commit ..."
            echo "  To bypass this hook: git commit --no-verify"
        } >&2
        exit 1
    fi
    git add "$repo_root/$snapshot"
    if ! git diff --cached --quiet -- "$repo_root/$snapshot"; then
        echo "pre-commit: $(basename "$snapshot") regenerated + staged."
    fi
fi

exit 0
