{
  "name": "jaato-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser client for jaato-server \u2014 the web counterpart of jaato-tui, built on @jaato/sdk.",
  "scripts": {
    "dev": "vite",
    "sdk:build": "npm --prefix ../jaato-sdk-ts run build",
    "build": "npm run sdk:build && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "npm run sdk:build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock-daemon": "node --import tsx mock/daemon.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@jaato/sdk": "file:../jaato-sdk-ts",
    "@tanstack/react-virtual": "^3.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "ws": "^8.21.3"
  }
}