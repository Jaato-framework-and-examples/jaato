# Workspace environment for the nim smoke harness.
#
# The api_key value below is interpolated into .jaato/profiles/*.json at
# profile-load time via ${JAATO_NIM_API_KEY} substitution (see
# shared/plugins/subagent/config.py:_expand_string).  The base_url is
# picked up directly by the provider from the environment (see
# shared/plugins/model_provider/nim/env.py:resolve_base_url).
#
# JAATO_NIM_API_KEY: API key from https://build.nvidia.com/
#   Required for the hosted NIM endpoint.  Get one by signing in at
#   build.nvidia.com and clicking "Get API Key" on any model card.
#   Format: nvapi-...
#
# JAATO_NIM_BASE_URL (optional): Override the API endpoint.  Leave unset
# to use NVIDIA's hosted API (https://integrate.api.nvidia.com/v1).
# Set this when targeting a self-hosted NIM container, e.g.:
#   http://localhost:8000/v1
#   http://nim.example.com:8000/v1
# For self-hosted endpoints (localhost / 192.168.* / 10.*) the provider
# treats the API key as optional.
#
# The provider will error naturally if the key is missing or rejected
# (APIKeyNotFoundError / AuthenticationError with a helpful message).

JAATO_NIM_API_KEY=nvapi-REPLACE_ME
# JAATO_NIM_BASE_URL=http://localhost:8000/v1
