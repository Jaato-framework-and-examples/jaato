# Workspace environment for the openrouter smoke harness.
#
# The API key below is interpolated into .jaato/profiles/*.json at
# profile-load time via ${JAATO_OPENROUTER_API_KEY} substitution (see
# shared/plugins/subagent/config.py:_expand_string).
#
# Get a key from https://openrouter.ai/settings/keys.  Format is
# sk-or-v1-... .  Prefer a pass:// URI so the literal token never
# lands on disk:
#
#   JAATO_OPENROUTER_API_KEY=pass://providers/openrouter/api_key
#
# A literal token works too — the provider treats both the same.
#
# The provider will error naturally if the key is missing or invalid
# (APIKeyNotFoundError / AuthenticationError with a helpful message).

JAATO_OPENROUTER_API_KEY=sk-or-v1-replace-me
