# Workspace environment for the tensorrt_llm smoke harness.
#
# The host value below is interpolated into .jaato/profiles/*.json at
# profile-load time via ${TENSORRT_LLM_HOST} substitution (see
# shared/plugins/subagent/config.py:_expand_string).
#
# Set this to your trtllm-serve or Triton OpenAI endpoint, e.g.:
#   http://localhost:8000           — local trtllm-serve
#   http://192.168.1.50:8000        — remote trtllm-serve on the LAN
#   http://triton.example.com:9000  — Triton OpenAI frontend
#
# The provider will error naturally if the endpoint is wrong or
# unreachable (TensorRTLLMConnectionError with a helpful message).

TENSORRT_LLM_HOST=http://localhost:8000
