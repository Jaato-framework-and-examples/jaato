# Workspace environment for the vllm smoke harness.
#
# The host value below is interpolated into .jaato/profiles/*.yaml at
# profile-load time via ${VLLM_HOST} substitution (see
# shared/plugins/subagent/config.py:_expand_string).
#
# Set this to your vLLM OpenAI-compatible endpoint, e.g.:
#   http://localhost:8000           — local vLLM
#   http://192.168.1.50:8000        — remote vLLM on the LAN
#   http://vllm.example.com:8000    — vLLM behind a reverse proxy
#
# The provider will error naturally if the endpoint is wrong or
# unreachable (VLLMConnectionError with a helpful message).
#
# If the vLLM server was launched with --api-key <token>, also set:
#   VLLM_API_TOKEN=<token>
# (or set plugin_configs.vllm.api_token in the profile YAML).

VLLM_HOST=http://localhost:8000
