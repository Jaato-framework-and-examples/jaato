# Workspace environment for the ollama smoke harness.
#
# The host value below is interpolated into .jaato/profiles/*.json at
# profile-load time via ${OLLAMA_HOST} substitution (see
# shared/plugins/subagent/config.py:_expand_string).
#
# Set this to your Ollama server URL, e.g.:
#   http://localhost:11434           — default local install
#   http://192.168.1.50:11434        — remote Ollama box on the LAN
#   http://ollama.example.com:11434  — Ollama fronted by a reverse proxy
#
# Ollama runs locally and does not require an API key — the
# Anthropic-compatible API at /v1/messages (Ollama v0.14.0+) accepts a
# dummy bearer.  The provider will error naturally if the endpoint is
# wrong or unreachable (OllamaConnectionError with a helpful message).

OLLAMA_HOST=http://localhost:11434
