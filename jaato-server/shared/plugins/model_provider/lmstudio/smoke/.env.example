# Workspace environment for the lmstudio smoke harness.
#
# The host value below is interpolated into .jaato/profiles/*.json at
# profile-load time via ${LMSTUDIO_HOST} substitution (see
# shared/plugins/subagent/config.py:_expand_string).
#
# Set this to your LM Studio local server endpoint, e.g.:
#   http://localhost:1234            — default LM Studio install
#   http://192.168.1.50:1234         — remote LM Studio on the LAN
#   http://lmstudio.example.com:1234 — LM Studio behind a reverse proxy
#
# Start the server from LM Studio's Developer tab ("Start Server") or
# with `lms server start`.  The provider will error naturally if the
# endpoint is wrong or unreachable (LMStudioConnectionError with a
# helpful message).
#
# OPTIONAL: LMSTUDIO_API_TOKEN — set this only when LM Studio is
# configured with "Require API Token" (Developer tab → Settings).  Copy
# the token from the LM Studio UI and uncomment the line below.  Leave
# it unset for the common local-dev case.

LMSTUDIO_HOST=http://localhost:1234
# LMSTUDIO_API_TOKEN=
