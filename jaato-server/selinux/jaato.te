policy_module(jaato, 1.10.0)

########################################
#
# jaato confinement module (docs/design/selinux-backend.md §4).
#
# What a session runner may do, by TYPE; which workspace it may do it to,
# by MCS LEVEL (one category pair per workspace, §5). The daemon stays in
# whatever domain systemd or the login shell gives it, as it stays
# unconfined under AppArmor.
#
# Each block names the AppArmor template lines it translates
# (jaato_server/server/apparmor.py, template v43). What AppArmor denies
# by path is here denied by NOT granting it; comments of the form
# "Deliberately absent" record those, and tests/test_policy_rules.py
# asserts both what is granted and what is not.
#
# Scope of this version (phase 4): the runner, //child and isolated
# sub-runner domains, the file types they share, and the pool slot's
# entry into the runner domain at fork (no template domain: the template
# stays in the daemon's, as it stays unconfined under AppArmor).
#

gen_require(`
	type unconfined_t;
	type unconfined_service_t;
	role system_r;
	role unconfined_r;
')

########################################
#
# Declarations
#

## The version marker. SELinuxBackend's readiness check asks whether
## system_u:object_r:jaato_policy_v4_t:s0 is a valid context (no
## privilege needed) and refuses an older module. Bump the number, and
## REQUIRED_POLICY_VERSION in server/confinement/selinux.py, together.
## v2 (phase 3): the isolated domains and the agent-config and prompts
## types; a workspace labelled for v1 is relabelled once.
## v3: jaato_runner_log_t, the isolated sub-runners' log files.
## v4 (phase 4): the daemon's domains may dyntransition into the runner
## domain, which is how a pool slot enters it at fork.
type jaato_policy_v4_t;
files_type(jaato_policy_v4_t)

## <desc>
## <p>
## Allow model-driven subprocesses (jaato_child_t) to make anonymous
## memory executable (execmem). Every JIT runtime needs it: node (V8)
## aborts before running a line without it, as do Java, .NET, LuaJIT and
## PyPy. On by default, as AppArmor and most targeted user domains allow
## it; set it off on a host whose sessions run no JIT. execmod (making a
## mapped FILE executable after writing it) is never granted either way.
## </p>
## </desc>
gen_tunable(jaato_child_execmem, true)

## The session runner (AppArmor: the base profile jaato-ws-<id>).
type jaato_runner_t;
domain_type(jaato_runner_t)

## Model-driven subprocesses: cli, interactive_shell, the notebook
## kernel (AppArmor: //child).
type jaato_child_t;
domain_type(jaato_child_t)

## An isolated subagent's sub-runner (AppArmor: the flat sub-profile
## jaato-ws-<parent>//<subagent>), and its read-only variant (the
## isolated_read_only_workspace tightening). Flat: no child domain, and
## nothing to exec (the AppArmor body grants exec on the venv's bin/
## only, whose interpreter resolves outside it).
type jaato_isolated_t;
domain_type(jaato_isolated_t)
type jaato_isolated_ro_t;
domain_type(jaato_isolated_ro_t)

## A user's own checkout (IPC, user-CWD): read/write, no execute.
type jaato_workspace_t;
files_type(jaato_workspace_t)

## A workspace the daemon manages under its workspace_root: as above,
## plus execute (#1273/#1274: node_modules/.bin, the tool venv).
type jaato_managed_ws_t;
files_type(jaato_managed_ws_t)

## Authored config inside a workspace (.jaato/references, templates,
## services, plans, ...): readable, never writable, renamable or removable
## by a session.
type jaato_authored_t;
files_type(jaato_authored_t)

## The authored entries an isolated sub-runner may not even read (.jaato/
## agents, profiles, scripts, both payload schemas, instructions,
## reactors.json; the AppArmor isolated sub-profile's read-denies). To a
## runner and its children, exactly jaato_authored_t.
type jaato_agent_config_t;
files_type(jaato_agent_config_t)

## .jaato/prompts/, the prompt library: written by sessions
## (prompt_library's savePrompt/deletePrompt), unreadable to an isolated
## sub-runner.
type jaato_prompts_t;
files_type(jaato_prompts_t)

## .jaato/references-claims/: the runner writes claims, //child cannot
## (template v43).
type jaato_claims_t;
files_type(jaato_claims_t)

## The session tmpdir and the private /tmp mount (#1171, #1381).
type jaato_tmp_t;
files_tmp_file(jaato_tmp_t)

## An isolated sub-runner's own log, .jaato/logs/runner-<id>.log. The
## daemon creates and labels it before the spawn; the read-only domain
## may append to it and to nothing else in the workspace (phase 3 kernel
## run: the read-only sub-runner's inherited log fds and its log handler
## were refused, so it ran with no log at all).
type jaato_runner_log_t;
files_type(jaato_runner_log_t)

## A pty a runner or child opens (interactive_shell, notebook kernels).
## Its own type, so the jaato domains need no access to anyone else's
## terminal (phase 2a run, design §12).
type jaato_devpts_t;
term_pty(jaato_devpts_t)

## ~/.jaato itself: traversed, never listed (phase 2b kernel run). A type
## of its own so a runner reaches its user tier without search on every
## user_home_t directory, which let a ROOT runner's child walk into other
## users' home trees, stopped only by DAC at a 0700 home. A file created
## directly in it (a stored *_auth.json) takes this type, which grants
## nothing on files.
type jaato_user_dir_t;
userdom_user_home_content(jaato_user_dir_t)

## The user-global tier, ~/.jaato: the subtrees the plugins grant under
## AppArmor (their get_apparmor_rules), and nothing else. Labelled by
## jaato.fc for every home (HOME_DIR) and /root. Read-only: agents/,
## profiles/, references/, services/, gc.json, the legacy memories.jsonl.
type jaato_user_config_t;
userdom_user_home_content(jaato_user_config_t)
## Writable: memories/ (the memory plugin's global tier), prompts/,
## skills/ (prompt_library).
type jaato_user_data_t;
userdom_user_home_content(jaato_user_data_t)

# A session keeps the daemon's SELinux user and role (setexeccon sets
# type and level only), so both roles the daemon runs under are
# authorized for the jaato domains. Phase 0: without the role, the
# transition fails with "user and role not authorized".
role system_r types { jaato_runner_t jaato_child_t jaato_isolated_t jaato_isolated_ro_t };
role unconfined_r types { jaato_runner_t jaato_child_t jaato_isolated_t jaato_isolated_ro_t };

# MCS: the level decides which workspace. Without this the targeted
# policy applies no MCS constraint to these types at all.
mcs_constrained(jaato_runner_t)
mcs_constrained(jaato_child_t)
mcs_constrained(jaato_isolated_t)
mcs_constrained(jaato_isolated_ro_t)

########################################
#
# Entering the runner: exec transition from the daemon (§7.1)
#

# The daemon forks, setexeccon()s, and execs the interpreter. The
# interpreter is bin_t (a venv's bin/python links to /usr/bin/python3.x).
allow unconfined_t jaato_runner_t:process transition;
allow unconfined_service_t jaato_runner_t:process transition;
corecmd_bin_entry_type(jaato_runner_t)

# A pool slot (phase 4, §7.2): forked from the template, which runs in the
# daemon's domain, it writes the runner's context to /proc/self/attr/current
# while it still has one thread. The kernel refuses that in a threaded
# process; a forked child has one. setcurrent is already held by every
# unconfined domain (unconfined_domain_type); unconfined_t holds
# dyntransition to every domain only under the unconfined_dyntrans_all
# boolean, and unconfined_service_t not at all, so both are granted here.
# The runner domain is mcs_constrained, the daemon's domains are not, so
# the MCS constraint on dyntransition lets the slot pick any category
# pair, as the exec transition does.
allow unconfined_t jaato_runner_t:process dyntransition;
allow unconfined_service_t jaato_runner_t:process dyntransition;

# Inherited descriptors. The runner's RPC socketpair, stdio pipes and log
# fd come from the daemon. Phase 0: without these the kernel closes them
# at exec, the denial is dontaudit-ed, and the runner starts with no RPC
# channel and no output.
allow jaato_runner_t { unconfined_t unconfined_service_t }:fd use;
allow jaato_runner_t { unconfined_t unconfined_service_t }:fifo_file rw_inherited_fifo_file_perms;
allow jaato_runner_t { unconfined_t unconfined_service_t }:unix_stream_socket { getattr getopt setopt read write shutdown };
allow jaato_runner_t { unconfined_t unconfined_service_t }:process sigchld;

########################################
#
# The runner itself
#

allow jaato_runner_t self:process { fork sigchld signal signull sigkill sigstop getattr getsched setsched getpgid setpgid getsession };
allow jaato_runner_t self:fifo_file rw_fifo_file_perms;
allow jaato_runner_t self:unix_stream_socket create_stream_socket_perms;
allow jaato_runner_t self:unix_dgram_socket create_socket_perms;

# /proc/self/** r, /proc/*/task/ r, owner /proc/*/limits r,
# /proc/cpuinfo r (AppArmor). SELinux labels /proc/<pid> with the
# process's own context, so "self" is exactly this domain at this level;
# another workspace's runner has another level and MCS refuses it
# (phase 0: the whole /proc/<pid> directory closes across levels).
allow jaato_runner_t self:dir list_dir_perms;
allow jaato_runner_t self:file rw_file_perms;
allow jaato_runner_t self:lnk_file read_lnk_file_perms;
kernel_read_system_state(jaato_runner_t)
kernel_read_kernel_sysctls(jaato_runner_t)
dev_read_sysfs(jaato_runner_t)
fs_getattr_all_fs(jaato_runner_t)

# Deliberately absent (AppArmor keeps change_profile -> unconfined and
# writes /proc/self/attr/current; SELinux does not need either, §4.4):
#   jaato_runner_t self:process { dyntransition setcurrent }
# so nothing running in the runner can change its own domain. The one
# process attribute it may set is the exec context of its children:
allow jaato_runner_t self:process setexec;
# #1543: a model-driven subprocess drops its capabilities in the forked
# child, still in jaato_runner_t (setexeccon changes nothing before
# execve): PR_CAPBSET_DROP needs setpcap, and capset (lowering its own
# permitted/effective/inheritable sets) is checked as process setcap.
# Both only lower sets; jaato_child_t holds no capability at all.
allow jaato_runner_t self:capability setpcap;
allow jaato_runner_t self:process setcap;
allow jaato_runner_t jaato_child_t:process transition;
# #1503: a model-driven subprocess sets PR_SET_NO_NEW_PRIVS and installs a
# seccomp filter between setexeccon and execve. Under no_new_privs the
# kernel refuses a domain transition at exec unless the policy grants
# nnp_transition (and nosuid_transition for a nosuid mount), so without
# this line every subprocess of a confined session would fail to start.
allow jaato_runner_t jaato_child_t:process2 { nnp_transition nosuid_transition };

########################################
#
# Model-driven subprocesses: //child (§7.3)
#

# The first exec after setexeccon: /bin/sh -c ... (shell_exec_t), a
# binary under /usr/bin (bin_t), or something a managed workspace built.
corecmd_shell_entry_type(jaato_child_t)
corecmd_bin_entry_type(jaato_child_t)
allow jaato_child_t jaato_managed_ws_t:file entrypoint;

allow jaato_child_t jaato_runner_t:fd use;
allow jaato_child_t jaato_runner_t:fifo_file rw_inherited_fifo_file_perms;
allow jaato_child_t jaato_runner_t:unix_stream_socket { getattr read write };
allow jaato_child_t jaato_runner_t:process sigchld;
allow jaato_runner_t jaato_child_t:process { signal signull sigkill sigstop getattr getpgid };
allow jaato_runner_t jaato_child_t:dir list_dir_perms;
allow jaato_runner_t jaato_child_t:file read_file_perms;

allow jaato_child_t self:process { fork sigchld signal signull sigkill sigstop getattr getsched setsched getpgid setpgid getsession setrlimit };
allow jaato_child_t self:fifo_file rw_fifo_file_perms;
allow jaato_child_t self:unix_stream_socket create_stream_socket_perms;
allow jaato_child_t self:unix_dgram_socket create_socket_perms;
allow jaato_child_t self:dir list_dir_perms;
allow jaato_child_t self:file read_file_perms;
allow jaato_child_t self:lnk_file read_lnk_file_perms;
kernel_read_system_state(jaato_child_t)
kernel_read_kernel_sysctls(jaato_child_t)
dev_read_sysfs(jaato_child_t)
fs_getattr_all_fs(jaato_child_t)

# execmem: anonymous writable-then-executable memory, which every JIT
# runtime needs (node aborts with a V8 fatal error without it, exit 133,
# with or without the seccomp filter). Behind jaato_child_execmem, default
# on. Anonymous memory only: execmod and execute on the workspace types
# stay ungranted, so a file the session wrote still cannot be mapped
# executable. The runner itself (CPython) needs none, and has none.
#
# Not granted: create on io_uring anon inodes. libuv falls back when
# io_uring_setup fails, and the #1503 seccomp filter denies io_uring for
# the same subprocesses anyway; the AVC it leaves is expected.
tunable_policy(`jaato_child_execmem',`
	allow jaato_child_t self:process execmem;
')

# Deliberately absent: jaato_child_t self:process { setexec dyntransition
# setcurrent }. A child cannot leave //child, and cannot choose the
# domain of what it runs next: it runs its own children in jaato_child_t.
#
# Deliberately absent: jaato_child_t read on jaato_runner_t:file. A
# subprocess cannot read the runner's /proc/<pid>/environ, mem or
# cmdline (AppArmor: audit deny /proc/*/environ etc.), which is where the
# provider credential lives.

########################################
#
# What both run: system binaries, libraries, the interpreter (AppArmor:
# /usr/bin/** ix r, /usr/lib/** rm, /etc/ld.so.cache r, /etc/passwd r,
# /etc/nsswitch.conf r, /etc/mime.types r, the venv and source tree r)
#
# The venv and an editable checkout must carry a readable type (lib_t by
# the operator's `semanage fcontext`, §9); under /home they are
# user_home_t, which neither domain can read. Stated, not worked around.
#

corecmd_exec_bin(jaato_runner_t)
corecmd_exec_shell(jaato_runner_t)
corecmd_exec_bin(jaato_child_t)
corecmd_exec_shell(jaato_child_t)
libs_use_ld_so(jaato_runner_t)
libs_use_shared_libs(jaato_runner_t)
libs_read_lib_files(jaato_runner_t)
libs_use_ld_so(jaato_child_t)
libs_use_shared_libs(jaato_child_t)
libs_read_lib_files(jaato_child_t)
files_read_usr_files(jaato_runner_t)
files_read_usr_files(jaato_child_t)
files_read_etc_files(jaato_runner_t)
files_read_etc_files(jaato_child_t)
auth_read_passwd(jaato_runner_t)
auth_read_passwd(jaato_child_t)
miscfiles_read_localization(jaato_runner_t)
miscfiles_read_localization(jaato_child_t)
miscfiles_read_generic_certs(jaato_runner_t)
miscfiles_read_generic_certs(jaato_child_t)

# /dev/null rw, /dev/urandom r
dev_rw_null(jaato_runner_t)
dev_rw_null(jaato_child_t)
dev_read_urand(jaato_runner_t)
dev_read_urand(jaato_child_t)
dev_read_rand(jaato_runner_t)
dev_read_rand(jaato_child_t)

# ptys: opening /dev/ptmx gives a slave the kernel labels devpts_t unless a
# type_transition says otherwise; term_create_pty is that transition, to
# jaato_devpts_t. The phase 2a kernel run found the runner without it:
# its new pty was devpts_t and unusable.
term_create_pty(jaato_runner_t, jaato_devpts_t)
term_create_pty(jaato_child_t, jaato_devpts_t)
allow { jaato_runner_t jaato_child_t } jaato_devpts_t:chr_file { rw_term_perms setattr };
#
# Deliberately absent: term_use_all_ptys (the ptynode attribute). It
# covers user_devpts_t and sshd_devpts_t, login terminals created at s0,
# and a runner's level dominates s0, so it would let a runner read, write
# and ioctl an administrator's terminal. Also absent: devpts_t itself
# (term_use_generic_ptys), the ptys of every domain that never relabels
# its own.

########################################
#
# Network (AppArmor: network inet/inet6 stream and dgram; deny raw)
#
# The runner calls provider APIs; a child runs git, pip, curl.
#

allow jaato_runner_t self:tcp_socket create_stream_socket_perms;
allow jaato_runner_t self:udp_socket create_socket_perms;
corenet_tcp_connect_all_ports(jaato_runner_t)
sysnet_dns_name_resolve(jaato_runner_t)
allow jaato_child_t self:tcp_socket create_stream_socket_perms;
allow jaato_child_t self:udp_socket create_socket_perms;
corenet_tcp_connect_all_ports(jaato_child_t)
sysnet_dns_name_resolve(jaato_child_t)

# Binding and listening, any address, ports 1024 and up: what AppArmor's
# `network inet stream` allows (checked on an enforcing kernel, 2026-10-02).
# The runner serves the webhook plugin (9100 by default, hplip_port_t,
# which unreserved_port_type covers); a child runs test and dev servers.
# urllib3's ::1 bind probe at import then succeeds, so urllib3 keeps IPv6.
# Ports below 1024 stay refused (reserved port types, no
# net_bind_service).
corenet_tcp_bind_generic_node(jaato_runner_t)
corenet_tcp_bind_generic_node(jaato_child_t)
corenet_tcp_bind_all_unreserved_ports(jaato_runner_t)
corenet_tcp_bind_all_unreserved_ports(jaato_child_t)
corenet_udp_bind_generic_node(jaato_runner_t)
corenet_udp_bind_generic_node(jaato_child_t)
corenet_udp_bind_all_unreserved_ports(jaato_runner_t)
corenet_udp_bind_all_unreserved_ports(jaato_child_t)

# Not granted, not logged (phase 2a run, traced on the import):
# cryptography's Rust core reads /proc/self/cgroup and cpu.max to size its
# thread pool (available_parallelism). Refused at the cgroup directory
# search, it uses the affinity mask.
fs_dontaudit_search_cgroup_dirs(jaato_runner_t)
fs_dontaudit_search_cgroup_dirs(jaato_child_t)
fs_dontaudit_search_cgroup_dirs(jaato_child_t)

# Deliberately absent: rawip_socket, packet_socket, netlink_route_socket
# write; every capability (sys_admin, net_admin, sys_ptrace, ...); ptrace;
# mount/mounton and filesystem mount. AppArmor states these as deny rules
# because it grants by path; here nothing grants them.

########################################
#
# The user-global tier, ~/.jaato (AppArmor: the @{HOME}/.jaato/... rules
# the plugins contribute, composed into base, tool_hat and //child alike)
#
# Reaching it takes search, never read, on the home directory and on
# ~/.jaato itself, so neither can be listed and nothing else in either can
# be opened: the stored *_auth.json credentials, instructions/ and
# permissions.json keep their home type. A runner dropped to a user
# (#1168) reads that user's home; a root runner reads /root.
#
userdom_search_user_home_dirs(jaato_runner_t)
userdom_search_user_home_dirs(jaato_child_t)
userdom_search_admin_dir(jaato_runner_t)
userdom_search_admin_dir(jaato_child_t)
allow { jaato_runner_t jaato_child_t } jaato_user_dir_t:dir search_dir_perms;
#
# Deliberately absent: userdom_search_user_home_content (search on every
# user_home_t directory). /root is admin_home_t throughout, so a runner can
# still traverse /root's own subdirectories by name (no listing, no file
# getattr); separating /root from its children needs a type of their own.
list_dirs_pattern({ jaato_runner_t jaato_child_t }, jaato_user_config_t, jaato_user_config_t)
read_files_pattern({ jaato_runner_t jaato_child_t }, jaato_user_config_t, jaato_user_config_t)
read_lnk_files_pattern({ jaato_runner_t jaato_child_t }, jaato_user_config_t, jaato_user_config_t)
manage_dirs_pattern({ jaato_runner_t jaato_child_t }, jaato_user_data_t, jaato_user_data_t)
manage_files_pattern({ jaato_runner_t jaato_child_t }, jaato_user_data_t, jaato_user_data_t)
manage_lnk_files_pattern({ jaato_runner_t jaato_child_t }, jaato_user_data_t, jaato_user_data_t)
allow { jaato_runner_t jaato_child_t } { jaato_user_config_t jaato_user_data_t }:file map;
# What a runner writes here is born at s0, not at its workspace's level.
# The tier is global by design (AppArmor gives every session the same
# ~/.jaato/memories/): a file at s0:c101,c102 could not be read by a
# runner of another workspace, and the memory tier would split per
# workspace without saying so.
range_transition { jaato_runner_t jaato_child_t } jaato_user_data_t:{ file dir lnk_file } s0;
#
# Deliberately absent: add_name on the home or on ~/.jaato (user_home_t,
# admin_home_t). memories/, prompts/ and skills/ must exist before a
# runner writes there; the operator creates them (design §9).

########################################
#
# The workspace (AppArmor: "<ws>/**" rwkl, and for a managed workspace
# "<ws>/**" mix from the toolchain plugin)
#
# The TYPE grants the operation; the LEVEL decides which workspace.
#

manage_dirs_pattern(jaato_runner_t, jaato_workspace_t, jaato_workspace_t)
manage_files_pattern(jaato_runner_t, jaato_workspace_t, jaato_workspace_t)
manage_lnk_files_pattern(jaato_runner_t, jaato_workspace_t, jaato_workspace_t)
manage_fifo_files_pattern(jaato_runner_t, jaato_workspace_t, jaato_workspace_t)
manage_sock_files_pattern(jaato_runner_t, jaato_workspace_t, jaato_workspace_t)
manage_dirs_pattern(jaato_child_t, jaato_workspace_t, jaato_workspace_t)
manage_files_pattern(jaato_child_t, jaato_workspace_t, jaato_workspace_t)
manage_lnk_files_pattern(jaato_child_t, jaato_workspace_t, jaato_workspace_t)
manage_fifo_files_pattern(jaato_child_t, jaato_workspace_t, jaato_workspace_t)
manage_sock_files_pattern(jaato_child_t, jaato_workspace_t, jaato_workspace_t)
allow { jaato_runner_t jaato_child_t } jaato_workspace_t:file { lock map };
# map (#1520): git mmaps .git/config, the packs and the index, and
# read/write without map refuses every mmap(2) of a file the domain may
# already read(2). Fedora grants map to every domain only under the
# domain_can_mmap_files boolean, off by default. map alone permits
# PROT_READ / PROT_WRITE mappings: PROT_EXEC on a file also needs execute,
# and execmod is a separate permission this module grants nowhere, so a
# mapping cannot be used to run what the session wrote. (execmem, granted
# to jaato_child_t behind jaato_child_execmem for JIT runtimes, covers
# anonymous memory only.)
#
# Deliberately absent: execute on jaato_workspace_t. A user's own
# checkout is not a place the session runs binaries from.

manage_dirs_pattern(jaato_runner_t, jaato_managed_ws_t, jaato_managed_ws_t)
manage_files_pattern(jaato_runner_t, jaato_managed_ws_t, jaato_managed_ws_t)
manage_lnk_files_pattern(jaato_runner_t, jaato_managed_ws_t, jaato_managed_ws_t)
manage_fifo_files_pattern(jaato_runner_t, jaato_managed_ws_t, jaato_managed_ws_t)
manage_sock_files_pattern(jaato_runner_t, jaato_managed_ws_t, jaato_managed_ws_t)
manage_dirs_pattern(jaato_child_t, jaato_managed_ws_t, jaato_managed_ws_t)
manage_files_pattern(jaato_child_t, jaato_managed_ws_t, jaato_managed_ws_t)
manage_lnk_files_pattern(jaato_child_t, jaato_managed_ws_t, jaato_managed_ws_t)
manage_fifo_files_pattern(jaato_child_t, jaato_managed_ws_t, jaato_managed_ws_t)
manage_sock_files_pattern(jaato_child_t, jaato_managed_ws_t, jaato_managed_ws_t)
allow { jaato_runner_t jaato_child_t } jaato_managed_ws_t:file { lock map execute execute_no_trans };

########################################
#
# Authored config (AppArmor: audit deny "<ws>/.jaato/agents/**" wlk and
# the same for profiles, scripts, services/*/, reactors.json,
# completion_schemas, spawn_schemas, instructions, references, templates,
# template_routing.yaml, plans, apparmor-fragments, .cache/apparmor-fragments)
#
# Read and search only. No write, append, create, unlink, rename,
# reparent, rmdir, setattr, add_name or remove_name: so a session can
# neither edit an authored file nor move the directory away and make a
# fresh one (§6).
#

list_dirs_pattern({ jaato_runner_t jaato_child_t }, jaato_authored_t, jaato_authored_t)
read_files_pattern({ jaato_runner_t jaato_child_t }, jaato_authored_t, jaato_authored_t)
read_lnk_files_pattern({ jaato_runner_t jaato_child_t }, jaato_authored_t, jaato_authored_t)
list_dirs_pattern({ jaato_runner_t jaato_child_t }, jaato_agent_config_t, jaato_agent_config_t)
read_files_pattern({ jaato_runner_t jaato_child_t }, jaato_agent_config_t, jaato_agent_config_t)
read_lnk_files_pattern({ jaato_runner_t jaato_child_t }, jaato_agent_config_t, jaato_agent_config_t)
# map with every read, for the reason on the workspace types (#1520).
allow { jaato_runner_t jaato_child_t } { jaato_authored_t jaato_agent_config_t }:file map;

# The two authored FILES directly under .jaato (the rest are directories,
# created at provisioning). AppArmor denies a write to the path whether or
# not the file exists; a label cannot sit on an absent file, so a file
# CREATED under one of these names is born jaato_authored_t, which neither
# domain may create: the creation is refused. The name matches in any
# workspace directory (both names are jaato's own).
#
# Not closed: creating the file under another name and renaming or
# hard-linking it into place. rename/link keep the source's type, and
# refusing add_name in .jaato would also refuse the runtime state the
# runner keeps there. AppArmor, which mediates paths, refuses that too.
type_transition { jaato_runner_t jaato_child_t jaato_isolated_t } { jaato_workspace_t jaato_managed_ws_t }:file jaato_agent_config_t "reactors.json";
type_transition { jaato_runner_t jaato_child_t jaato_isolated_t } { jaato_workspace_t jaato_managed_ws_t }:file jaato_authored_t "template_routing.yaml";

########################################
#
# The prompt library (AppArmor: written by base and //child alike; read-
# denied to the isolated sub-profile)
#

manage_dirs_pattern({ jaato_runner_t jaato_child_t }, jaato_prompts_t, jaato_prompts_t)
manage_files_pattern({ jaato_runner_t jaato_child_t }, jaato_prompts_t, jaato_prompts_t)
manage_lnk_files_pattern({ jaato_runner_t jaato_child_t }, jaato_prompts_t, jaato_prompts_t)
allow { jaato_runner_t jaato_child_t } jaato_prompts_t:file map;

########################################
#
# Reference claims (template v43: the runner's proposeReference writes
# them; //child is write-denied, so no shell command can forge one)
#

manage_dirs_pattern(jaato_runner_t, jaato_claims_t, jaato_claims_t)
manage_files_pattern(jaato_runner_t, jaato_claims_t, jaato_claims_t)
list_dirs_pattern(jaato_child_t, jaato_claims_t, jaato_claims_t)
read_files_pattern(jaato_child_t, jaato_claims_t, jaato_claims_t)
allow { jaato_runner_t jaato_child_t } jaato_claims_t:file map;

########################################
#
# Temporary files (AppArmor: /tmp/jaato-<id>/** rw, and the private /tmp
# grants of template v39/v41)
#
# The daemon creates and labels the session tmpdir and mounts the private
# /tmp and /dev/shm with context=jaato_tmp_t. A domain may search /tmp to
# reach its tmpdir; it may not create files directly in the host's /tmp.
#

files_search_tmp(jaato_runner_t)
files_search_tmp(jaato_child_t)
manage_dirs_pattern({ jaato_runner_t jaato_child_t }, jaato_tmp_t, jaato_tmp_t)
manage_files_pattern({ jaato_runner_t jaato_child_t }, jaato_tmp_t, jaato_tmp_t)
manage_lnk_files_pattern({ jaato_runner_t jaato_child_t }, jaato_tmp_t, jaato_tmp_t)
manage_sock_files_pattern({ jaato_runner_t jaato_child_t }, jaato_tmp_t, jaato_tmp_t)
allow { jaato_runner_t jaato_child_t } jaato_tmp_t:file { lock map };
allow jaato_tmp_t self:filesystem associate;

# Deliberately absent: add_name on tmp_t (the host's /tmp). Models write
# to /tmp by habit; #1381's private /tmp is the answer, not a grant on
# the host's /tmp.

########################################
#
# The isolated sub-runner (AppArmor: the flat sub-profile rendered by
# AppArmorManager._render_sub_profile; design §5.3)
#
# It works in its parent's workspace, so it runs at the PARENT's level.
# Translated rule by rule from that body:
#   workspace "<ws>/**" rwkl, or r under isolated_read_only_workspace;
#   the authored write-denies; read-denies on the persona/config entries
#   and prompts/; /tmp/jaato-*/** rwkl; /proc self-introspection; network
#   through abstractions/nameservice; the venv and source tree r.
# Absent, as in that body: every exec (it has no //child and no
# /usr/bin grant), ptys, and the user tier beyond two TUI files (the
# runner reads its user tier from the envelope's snapshot, #1465, which
# lands in its session tmpdir).
#

allow unconfined_t { jaato_isolated_t jaato_isolated_ro_t }:process transition;
allow unconfined_service_t { jaato_isolated_t jaato_isolated_ro_t }:process transition;
corecmd_bin_entry_type(jaato_isolated_t)
corecmd_bin_entry_type(jaato_isolated_ro_t)
allow { jaato_isolated_t jaato_isolated_ro_t } { unconfined_t unconfined_service_t }:fd use;
allow { jaato_isolated_t jaato_isolated_ro_t } { unconfined_t unconfined_service_t }:fifo_file rw_inherited_fifo_file_perms;
allow { jaato_isolated_t jaato_isolated_ro_t } { unconfined_t unconfined_service_t }:unix_stream_socket { getattr getopt setopt read write shutdown };
allow { jaato_isolated_t jaato_isolated_ro_t } { unconfined_t unconfined_service_t }:process sigchld;

allow { jaato_isolated_t jaato_isolated_ro_t } self:process { fork sigchld signal signull sigkill sigstop getattr getsched setsched getpgid setpgid getsession };
allow { jaato_isolated_t jaato_isolated_ro_t } self:fifo_file rw_fifo_file_perms;
allow { jaato_isolated_t jaato_isolated_ro_t } self:unix_stream_socket create_stream_socket_perms;
allow { jaato_isolated_t jaato_isolated_ro_t } self:unix_dgram_socket create_socket_perms;
allow { jaato_isolated_t jaato_isolated_ro_t } self:dir list_dir_perms;
allow { jaato_isolated_t jaato_isolated_ro_t } self:file rw_file_perms;
allow { jaato_isolated_t jaato_isolated_ro_t } self:lnk_file read_lnk_file_perms;
kernel_read_system_state(jaato_isolated_t)
kernel_read_system_state(jaato_isolated_ro_t)
kernel_read_kernel_sysctls(jaato_isolated_t)
kernel_read_kernel_sysctls(jaato_isolated_ro_t)
dev_read_sysfs(jaato_isolated_t)
dev_read_sysfs(jaato_isolated_ro_t)
fs_getattr_all_fs(jaato_isolated_t)
fs_getattr_all_fs(jaato_isolated_ro_t)
fs_dontaudit_search_cgroup_dirs(jaato_isolated_t)
fs_dontaudit_search_cgroup_dirs(jaato_isolated_ro_t)
#
# Deliberately absent: self:process { setexec dyntransition setcurrent }
# (the sub-profile's "DROP: change_profile transitions"), and every
# execute: corecmd_exec_bin, corecmd_exec_shell, execute on the
# workspace types.

# The interpreter and its libraries, read only.
libs_use_ld_so(jaato_isolated_t)
libs_use_ld_so(jaato_isolated_ro_t)
libs_use_shared_libs(jaato_isolated_t)
libs_use_shared_libs(jaato_isolated_ro_t)
libs_read_lib_files(jaato_isolated_t)
libs_read_lib_files(jaato_isolated_ro_t)
corecmd_read_bin_files(jaato_isolated_t)
corecmd_read_bin_files(jaato_isolated_ro_t)
files_read_usr_files(jaato_isolated_t)
files_read_usr_files(jaato_isolated_ro_t)
files_read_etc_files(jaato_isolated_t)
files_read_etc_files(jaato_isolated_ro_t)
auth_read_passwd(jaato_isolated_t)
auth_read_passwd(jaato_isolated_ro_t)
miscfiles_read_localization(jaato_isolated_t)
miscfiles_read_localization(jaato_isolated_ro_t)
miscfiles_read_generic_certs(jaato_isolated_t)
miscfiles_read_generic_certs(jaato_isolated_ro_t)
dev_rw_null(jaato_isolated_t)
dev_rw_null(jaato_isolated_ro_t)
dev_read_urand(jaato_isolated_t)
dev_read_urand(jaato_isolated_ro_t)
dev_read_rand(jaato_isolated_t)
dev_read_rand(jaato_isolated_ro_t)

# Network: abstractions/nameservice's inet/inet6 stream and dgram.
allow { jaato_isolated_t jaato_isolated_ro_t } self:tcp_socket create_stream_socket_perms;
allow { jaato_isolated_t jaato_isolated_ro_t } self:udp_socket create_socket_perms;
corenet_tcp_connect_all_ports(jaato_isolated_t)
corenet_tcp_connect_all_ports(jaato_isolated_ro_t)
sysnet_dns_name_resolve(jaato_isolated_t)
sysnet_dns_name_resolve(jaato_isolated_ro_t)
corenet_tcp_bind_generic_node(jaato_isolated_t)
corenet_tcp_bind_generic_node(jaato_isolated_ro_t)
corenet_tcp_bind_all_unreserved_ports(jaato_isolated_t)
corenet_tcp_bind_all_unreserved_ports(jaato_isolated_ro_t)
corenet_udp_bind_generic_node(jaato_isolated_t)
corenet_udp_bind_generic_node(jaato_isolated_ro_t)
corenet_udp_bind_all_unreserved_ports(jaato_isolated_t)
corenet_udp_bind_all_unreserved_ports(jaato_isolated_ro_t)

# The workspace: read-write for jaato_isolated_t, read only for
# jaato_isolated_ro_t (AppArmor: rwkl / r on "<ws>/**").
manage_dirs_pattern(jaato_isolated_t, { jaato_workspace_t jaato_managed_ws_t }, { jaato_workspace_t jaato_managed_ws_t })
manage_files_pattern(jaato_isolated_t, { jaato_workspace_t jaato_managed_ws_t }, { jaato_workspace_t jaato_managed_ws_t })
manage_lnk_files_pattern(jaato_isolated_t, { jaato_workspace_t jaato_managed_ws_t }, { jaato_workspace_t jaato_managed_ws_t })
allow jaato_isolated_t { jaato_workspace_t jaato_managed_ws_t }:file { lock map };
list_dirs_pattern(jaato_isolated_ro_t, { jaato_workspace_t jaato_managed_ws_t }, { jaato_workspace_t jaato_managed_ws_t })
read_files_pattern(jaato_isolated_ro_t, { jaato_workspace_t jaato_managed_ws_t }, { jaato_workspace_t jaato_managed_ws_t })
read_lnk_files_pattern(jaato_isolated_ro_t, { jaato_workspace_t jaato_managed_ws_t }, { jaato_workspace_t jaato_managed_ws_t })
# map, not write: a read-only mapping (#1520).
allow jaato_isolated_ro_t { jaato_workspace_t jaato_managed_ws_t }:file map;

# Authored config it may read (references, templates, services, plans, the
# routing table, the fragment tiers), and claims (inside the workspace, so
# rwkl / r like the rest of it).
list_dirs_pattern({ jaato_isolated_t jaato_isolated_ro_t }, jaato_authored_t, jaato_authored_t)
read_files_pattern({ jaato_isolated_t jaato_isolated_ro_t }, jaato_authored_t, jaato_authored_t)
read_lnk_files_pattern({ jaato_isolated_t jaato_isolated_ro_t }, jaato_authored_t, jaato_authored_t)
manage_dirs_pattern(jaato_isolated_t, jaato_claims_t, jaato_claims_t)
manage_files_pattern(jaato_isolated_t, jaato_claims_t, jaato_claims_t)
list_dirs_pattern(jaato_isolated_ro_t, jaato_claims_t, jaato_claims_t)
read_files_pattern(jaato_isolated_ro_t, jaato_claims_t, jaato_claims_t)
allow { jaato_isolated_t jaato_isolated_ro_t } { jaato_authored_t jaato_claims_t }:file map;
#
# Deliberately absent: any access to jaato_agent_config_t and
# jaato_prompts_t (the sub-profile's read-denies: information isolation
# between agents of a cascade), and to the user tier
# (jaato_user_dir_t, jaato_user_config_t, jaato_user_data_t).

# The session tmpdir, labelled by the daemon at the parent's level
# (AppArmor: /tmp/jaato-*/** rwkl, kept by the read-only variant too).
files_search_tmp(jaato_isolated_t)
files_search_tmp(jaato_isolated_ro_t)
manage_dirs_pattern({ jaato_isolated_t jaato_isolated_ro_t }, jaato_tmp_t, jaato_tmp_t)
manage_files_pattern({ jaato_isolated_t jaato_isolated_ro_t }, jaato_tmp_t, jaato_tmp_t)
manage_lnk_files_pattern({ jaato_isolated_t jaato_isolated_ro_t }, jaato_tmp_t, jaato_tmp_t)
manage_sock_files_pattern({ jaato_isolated_t jaato_isolated_ro_t }, jaato_tmp_t, jaato_tmp_t)
allow { jaato_isolated_t jaato_isolated_ro_t } jaato_tmp_t:file { lock map };
# Their log: append only (no write, create, unlink, rename or setattr).
allow { jaato_isolated_t jaato_isolated_ro_t } jaato_runner_log_t:file { getattr open append ioctl lock };
