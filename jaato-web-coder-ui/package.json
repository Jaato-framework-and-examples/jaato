{
  "name": "@jaato/web-coder-ui",
  "version": "0.1.8",
  "description": "Browser client for jaato-server — the web counterpart of jaato-tui. `npx @jaato/web-coder-ui` serves the bundle and opens it against a daemon started with --web-socket.",
  "license": "BUSL-1.1",
  "author": "apanoia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaato-framework-and-examples/jaato.git",
    "directory": "jaato-web-coder-ui"
  },
  "keywords": [
    "jaato",
    "client",
    "web",
    "browser",
    "llm",
    "agent"
  ],
  "type": "module",
  "bin": {
    "jaato-web-coder-ui": "bin/jaato-web-coder-ui.js"
  },
  "types": "./bin/jaato-web-coder-ui.d.ts",
  "exports": {
    ".": {
      "types": "./bin/jaato-web-coder-ui.d.ts",
      "default": "./bin/jaato-web-coder-ui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "bin/jaato-web-coder-ui.js",
    "bin/jaato-web-coder-ui.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "sdk:build": "npm --prefix ../jaato-sdk-ts run build",
    "build": "npm run sdk:build && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "start": "node bin/jaato-web-coder-ui.js",
    "typecheck": "npm run sdk:build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run && npm run test:bin",
    "test:bin": "node --test bin/jaato-web-coder-ui.test.js",
    "test:watch": "vitest",
    "mock-daemon": "node --import tsx mock/daemon.ts",
    "e2e": "playwright test",
    "prepack": "node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@jaato/sdk": "file:../jaato-sdk-ts",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-virtual": "^3.13.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.0"
  }
}
