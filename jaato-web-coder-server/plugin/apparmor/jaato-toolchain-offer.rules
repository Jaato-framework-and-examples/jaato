# jaato-toolchain-offer: keep the model from rewriting the toolchain offer.
#
# .jaato/toolchain-offer.json is staged into each workspace by the web coder
# page (through the daemon) and read by the toolchain_offer enrichment
# plugin in the runner.  A confined session may READ it; this denies it
# writing, linking or locking it, so the agent cannot change what the
# plugin tells the model and the page.  The daemon, which stages the file,
# is not confined and is not affected.
#
# Install into the daemon account's user tier, where it applies to every
# workspace:  ~/.jaato/apparmor-fragments/jaato-toolchain-offer.rules
# (see INSTALL.md).  An unscoped session composes it automatically; a
# profile that declares apparmor_fragments: must list jaato-toolchain-offer.
# It takes effect for sessions provisioned after it is installed.

  audit deny /**/.jaato/toolchain-offer.json wlk,
