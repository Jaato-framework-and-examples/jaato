# Vendored from github/gitignore (CC0-1.0)
# https://github.com/github/gitignore/blob/62f3997f1917b30f6eaee0c53ac2d791426513f2/Java.gitignore
# Do not edit by hand; refresh with scripts and re-run the checksum test.
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
